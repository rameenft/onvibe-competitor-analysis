# Apify (https://console.apify.com/account/integrations for your token)
APIFY_API_TOKEN=

# Apify actor IDs — verify these still match the intended actor in the Apify
# Store before a real run; swap freely if a better/cheaper actor exists.
APIFY_IG_PROFILE_ACTOR_ID=apify/instagram-profile-scraper
APIFY_IG_POST_ACTOR_ID=apify/instagram-post-scraper
APIFY_TIKTOK_PROFILE_ACTOR_ID=clockworks/tiktok-profile-scraper
APIFY_TIKTOK_POST_ACTOR_ID=clockworks/tiktok-scraper
APIFY_LINKEDIN_PROFILE_ACTOR_ID=scrapier/linkedin-company-scraper-actor
APIFY_LINKEDIN_POST_ACTOR_ID=harvestapi/linkedin-company-posts
APIFY_SOCIALBLADE_ACTOR_ID=amrameng/socialblade-scraper

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (https://aistudio.google.com/apikey) -- post classification and report
# writing in the worker, plus ml/ (evals + knowledge graph). ML_MODEL overrides the model for ml/ only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional, ml/ only: lets the evals compare against Claude models (--model claude-...).
ANTHROPIC_API_KEY=

# Internal
WORKER_POLL_INTERVAL_MS=5000
APP_BASE_URL=http://localhost:3000

# Optional: lets the web app tell GitHub Actions to run the worker
# immediately on submit, instead of waiting for the next scheduled tick
# (which GitHub can delay by hours in practice). A token with `repo` scope
# and the "owner/repo" string. Falls back gracefully to the schedule alone
# if left unset.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=rameenft/onvibe-competitor-analysis
